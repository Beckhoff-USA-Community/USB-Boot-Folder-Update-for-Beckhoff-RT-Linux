# Everything this repo ships runs on the Linux CX9240 — keep LF line endings
# in the working tree even when checked out on Windows. A CRLF in a shell
# script or systemd unit breaks it on the device (bash: '\r': command not found).

# Sensible default: normalize text, LF in the working tree
* text=auto eol=lf

# Explicit, for clarity — these must never gain CRLF
*.sh      text eol=lf
*.conf    text eol=lf
*.service text eol=lf
*.md      text eol=lf

# Anything binary that may land here later
*.png     binary
*.db      binary
*.tszip   binary
*.tizip   binary
*.tpzip   binary
