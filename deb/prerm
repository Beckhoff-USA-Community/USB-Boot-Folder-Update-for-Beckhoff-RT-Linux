#!/bin/sh
set -e

conf=/etc/usb-update/usb-update.conf

# Pull a value out of the config with sed instead of sourcing it: the config
# is bash (it contains an array) and this script is POSIX sh.
conf_val() {
    v=$(sed -n "s/^$1=//p" "$conf" 2>/dev/null | tail -n 1)
    if [ -n "$v" ]; then printf '%s\n' "$v"; else printf '%s\n' "$2"; fi
}

case "$1" in
    remove)
        # A pending-validation marker means the last update/restore was never
        # confirmed healthy: .old rollback state may still exist and
        # validate.sh is the machinery that would offer the revert. Don't
        # silently remove that safety net.
        state_dir=$(conf_val STATE_DIR /var/lib/usb-update)
        if [ -f "$state_dir/pending-validation" ]; then
            echo "ERROR: $state_dir/pending-validation exists - the last update has not" >&2
            echo "been validated yet. Reboot so validation can finish (or resolve the" >&2
            echo "failed state), or delete that marker file to remove the package anyway." >&2
            exit 1
        fi
        # Un-gate the TF1200 UI Client launch BEFORE the package files are
        # removed: a sway config exec'ing a deleted ui-gate.sh would leave the
        # machine with no HMI at all.
        /usr/lib/usb-update/sway-gate.sh ungate
        if [ -d /run/systemd/system ]; then
            systemctl disable usb-update.service usb-update-validate.service 2>/dev/null || true
        fi
        ;;
esac

exit 0
